rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt'])
        && data.id == request.auth.uid
        && data.id is string
        && data.email is string && data.email.size() <= 256
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    function isValidForm(data) {
      return data.keys().hasAll(['id', 'userId', 'recordNumber', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'formId', 'userId', 'recordNumber', 'applicantName', 'answersJson', 'uploadedFilesJson', 'status', 'submitted', 'submittedAt', 'savedAt', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.recordNumber is string && data.recordNumber.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('applicantName' in data) || (data.applicantName is string && data.applicantName.size() <= 256))
        && (!('answersJson' in data) || (data.answersJson is string && data.answersJson.size() <= 2097152))
        && (!('uploadedFilesJson' in data) || (data.uploadedFilesJson is string && data.uploadedFilesJson.size() <= 20971520))
        && (!('status' in data) || (data.status is string && data.status in ['draft', 'submitted', 'verified']))
        && (!('submitted' in data) || data.submitted is bool)
        && (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 64))
        && (!('savedAt' in data) || (data.savedAt is string && data.savedAt.size() <= 64));
    }

    function isValidVerification(data) {
      return data.keys().hasAll(['id', 'userId', 'recordNumber', 'verificationId', 'verifiedAt'])
        && data.keys().hasOnly(['id', 'userId', 'recordNumber', 'verificationId', 'applicantName', 'interviewSerialNumber', 'verifiedContact', 'verifiedAt', 'createdAt'])
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.recordNumber is string && data.recordNumber.size() <= 128
        && data.verificationId is string && data.verificationId.size() <= 128
        && data.verifiedAt is string && data.verifiedAt.size() <= 64
        && (!('applicantName' in data) || (data.applicantName is string && data.applicantName.size() <= 256))
        && (!('interviewSerialNumber' in data) || (data.interviewSerialNumber is string && data.interviewSerialNumber.size() <= 128))
        && (!('verifiedContact' in data) || (data.verifiedContact is string && data.verifiedContact.size() <= 256))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /forms/{formId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(formId) && isValidForm(request.resource.data);
      allow update: if isSignedIn() && isValidId(formId) && isValidForm(request.resource.data)
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(formId) && resource.data.userId == request.auth.uid;
    }

    match /verifications/{verificationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(verificationId) && isValidVerification(request.resource.data);
      allow update: if isSignedIn() && isValidId(verificationId) && isValidVerification(request.resource.data)
        && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data)
        && request.resource.data.id == resource.data.id;
      allow delete: if false;

      match /forms/{formId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(formId) && isValidForm(request.resource.data);
        allow update: if isOwner(userId) && isValidId(formId) && isValidForm(request.resource.data)
          && resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(formId);
      }

      match /verifications/{verificationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(verificationId) && isValidVerification(request.resource.data);
        allow update: if isOwner(userId) && isValidId(verificationId) && isValidVerification(request.resource.data)
          && resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
